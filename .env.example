# Copy to .env.local (dev) or set in your host's dashboard. Every key is optional:
# without any of them the app runs on keyless public sources and the built-in quant engine.

# --- AI analysis & market brief (first match wins) -------------------------------------------
# Any OpenAI-compatible endpoint. AI_BASE_URL/AI_MODEL also apply to this key.
# OPENAI_API_KEY=
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-5-mini

# Google Gemini (free tier): https://aistudio.google.com/apikey  -> default model gemini-2.5-flash
# GEMINI_API_KEY=

# Groq (free tier): https://console.groq.com/keys  -> default model llama-3.3-70b-versatile
# GROQ_API_KEY=

# OpenRouter (pay-as-you-go, some free models): https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# --- Market data (all optional) ----------------------------------------------------------------
# Finnhub free tier, used as a backup for quotes, company news and earnings if Yahoo is blocked:
# https://finnhub.io/register
# FINNHUB_API_KEY=

# FRED API key raises rate limits for macro indicators (keyless CSV is used otherwise):
# https://fredaccount.stlouisfed.org/apikeys
# FRED_API_KEY=

# CoinGecko demo key for higher crypto rate limits: https://www.coingecko.com/en/developers/dashboard
# COINGECKO_API_KEY=
